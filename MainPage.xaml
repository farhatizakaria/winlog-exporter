<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LogCollector.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:LogCollector.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Subtle hover for list items -->
        <Style x:Key="LogItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
        <Grid Padding="24" RowSpacing="16" MaxWidth="1080">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- HERO — glass -->
            <Border
                Grid.Row="0"
                CornerRadius="16"
                BorderThickness="1"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                Padding="20">
                <!-- soft accent wash -->
                <Border.BackgroundTransition>
                    <BrushTransition />
                </Border.BackgroundTransition>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="56"
                        Height="56"
                        CornerRadius="14"
                        VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#FF6B6BFF" />
                                <GradientStop Offset="1" Color="#FF00D1FF" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <FontIcon
                            Glyph="&#xE9D9;"
                            FontSize="28"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Windows Log Collector" Style="{StaticResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                        <TextBlock
                            Text="Only Windows Logs — Application, Security, Setup, System, ForwardedEvents — exported as native .evtx."
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Opacity="0.9" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Border Padding="8,3" CornerRadius="99" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE80A;" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Hostname in folder name" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Padding="8,3" CornerRadius="99" Background="{ThemeResource SystemFillColorSuccessBrush}" Opacity="0.95">
                                <TextBlock Text="• .evtx ready" FontSize="11" Foreground="White" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <Button
                            Command="{x:Bind ViewModel.OpenEventViewerCommand, Mode=OneWay}"
                            AutomationProperties.AutomationId="BtnOpenEventViewer"
                            ToolTipService.ToolTip="Open Windows Event Viewer">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7B8;" FontSize="13" />
                                <TextBlock Text="Event Viewer" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{x:Bind ViewModel.LoadLogsCommand, Mode=OneWay}"
                            AutomationProperties.AutomationId="BtnRefreshLogs">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Infobars -->
            <StackPanel Grid.Row="1" Spacing="8">
                <InfoBar
                    Title="Administrator recommended"
                    Message="Not running as Administrator — Security log will fail. Right-click → Run as administrator for full Windows Logs coverage."
                    Severity="Warning"
                    IsOpen="{x:Bind ViewModel.IsAdmin, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                    IsClosable="False"
                    CornerRadius="10" />
                <InfoBar
                    IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay, Converter={StaticResource StringToSeverityConverter}}"
                    Title="Status"
                    Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    IsClosable="True"
                    CornerRadius="10" />
            </StackPanel>

            <!-- DESTINATION — glass card -->
            <Border
                Grid.Row="2"
                CornerRadius="16"
                BorderThickness="1"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                Padding="18">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="28" Height="28" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="Destination — hostname is baked into the folder name" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Each export creates a unique WindowsLogs_HOST_timestamp folder — ready to zip &amp; share" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            Text="{x:Bind ViewModel.DestinationFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="C:\Logs\WindowsLogs_HOST_2026..."
                            AutomationProperties.AutomationId="TxtDestinationFolder" />
                        <Button
                            Grid.Column="1"
                            Content="Browse…"
                            Command="{x:Bind ViewModel.BrowseFolderCommand, Mode=OneWay}"
                            AutomationProperties.AutomationId="BtnBrowseFolder"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            Grid.Column="2"
                            Command="{x:Bind ViewModel.OpenDestinationCommand, Mode=OneWay}"
                            AutomationProperties.AutomationId="BtnOpenFolder"
                            ToolTipService.ToolTip="Open destination in Explorer">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                                <TextBlock Text="Open" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="2" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Padding="10,4" CornerRadius="99" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8FB;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay}" FontWeight="SemiBold" />
                                    <TextBlock Text="selected" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    <TextBlock Text="·" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0" />
                                    <TextBlock Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}" FontWeight="SemiBold" />
                                    <TextBlock Text="Windows Logs" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Grid>
            </Border>

            <!-- LOGS — glass card -->
            <Border
                Grid.Row="3"
                CornerRadius="16"
                BorderThickness="1"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                Padding="18">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- toolbar -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE9D5;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Windows Logs" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>
                        <AutoSuggestBox
                            Grid.Column="1"
                            PlaceholderText="Filter (Security, System…)"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            QueryIcon="Find"
                            AutomationProperties.AutomationId="SearchLogsBox"
                            MinWidth="240"
                            MaxWidth="420"
                            HorizontalAlignment="Stretch" />
                        <Button Grid.Column="2" Content="Select all" Command="{x:Bind ViewModel.SelectAllCommand, Mode=OneWay}" AutomationProperties.AutomationId="BtnSelectAll" Style="{StaticResource DefaultButtonStyle}" />
                        <Button Grid.Column="3" Content="Deselect all" Command="{x:Bind ViewModel.DeselectAllCommand, Mode=OneWay}" AutomationProperties.AutomationId="BtnDeselectAll" />
                    </Grid>

                    <!-- header -->
                    <Border Grid.Row="1" CornerRadius="8" Padding="12,8" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="" />
                            <TextBlock Grid.Column="1" Text="Windows Log" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Type" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Records" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="Size" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="5" Text="Status" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                        </Grid>
                    </Border>

                    <!-- list -->
                    <Grid Grid.Row="2" MinHeight="220">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <ListView
                            ItemsSource="{x:Bind ViewModel.FilteredLogs, Mode=OneWay}"
                            SelectionMode="None"
                            ItemContainerStyle="{StaticResource LogItemStyle}"
                            AutomationProperties.AutomationId="ListEventLogs"
                            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityInvertedConverter}}"
                            MaxHeight="420"
                            ShowsScrollingPlaceholders="False">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:LogChannelInfo">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" AutomationProperties.AutomationId="{x:Bind LogName}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind LogName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind LogName}" Style="{StaticResource BodyTextBlockStyle}" FontWeight="Medium" />
                                        <Border Grid.Column="2" Padding="8,2" CornerRadius="99" HorizontalAlignment="Left" Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                                            <TextBlock Text="{x:Bind CategoryDisplay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="{x:Bind RecordCountDisplay}" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind FileSizeDisplay}" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Right" />
                                        <Border Grid.Column="5" Padding="8,2" CornerRadius="99" HorizontalAlignment="Center" Background="{ThemeResource SystemFillColorSuccessBrush}" Opacity="0.92">
                                            <TextBlock Text="{x:Bind StatusDisplay}" FontSize="11" Foreground="White" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="{x:Bind ViewModel.IsFilteredEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon Glyph="&#xE71E;" FontSize="20" Opacity="0.4" HorizontalAlignment="Center" />
                            <TextBlock Text="No Windows Logs match filter" Opacity="0.6" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ACTION — glass -->
            <Border
                Grid.Row="4"
                CornerRadius="16"
                BorderThickness="1"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                Padding="18">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="8" VerticalAlignment="Center">
                        <ProgressBar Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" Minimum="0" Maximum="100" AutomationProperties.AutomationId="ProgressBar" CornerRadius="4" />
                        <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Cancel" Command="{x:Bind ViewModel.CancelCollectCommand, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsCollecting, Mode=OneWay}" AutomationProperties.AutomationId="BtnCancel" />
                        <Button
                            AutomationProperties.AutomationId="BtnCollectAllLogs"
                            Command="{x:Bind ViewModel.CollectCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.IsCollecting, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                            Style="{StaticResource AccentButtonStyle}"
                            Padding="18,8"
                            CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontSize="15" />
                                <TextBlock Text="Export Windows Logs" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <InfoBar Grid.Row="1" Grid.ColumnSpan="2" Severity="Informational" Title="Native .evtx" Message="Double-click any .evtx to open in Event Viewer. Folder name includes hostname &amp; timestamp for forensics." IsOpen="True" IsClosable="False" CornerRadius="8" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
